# --- Voice platform (Vapi) ---
VAPI_PRIVATE_KEY=
VAPI_ASSISTANT_ID=
# Public URL of your deployment, where the platform calls your webhooks:
WEBHOOK_BASE_URL=https://your-deployment.example.com
# Shared secret the platform sends back as x-vapi-secret (set the same value on the assistant):
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Calendar (Cal.com) ---
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# --- Email recap (Resend) ---
RESEND_API_KEY=
MAIL_FROM="Accueil <accueil@your-domain.fr>"

# --- SMS recap (Brevo) ---
BREVO_API_KEY=
SMS_SENDER=Accueil

# --- Storage (your source of truth) ---
# A JSON file is fine for a demo; use Postgres/SQLite/Upstash in production.
DATA_FILE=./data/records.json

# --- Fallback single-client config, used only if config/client.json is absent ---
CLIENT_COMPANY=Plomberie Dupont
CLIENT_METIER=plomberie
CLIENT_HORAIRES=du lundi au vendredi, de 8h a 18h
NOTIFY_EMAIL=contact@plomberie-dupont.fr
NOTIFY_SMS=33612345678
