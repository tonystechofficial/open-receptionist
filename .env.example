# --- Voice platform (Vapi) ---
VAPI_PRIVATE_KEY=
VAPI_ASSISTANT_ID=
# Id of the Vapi Custom Credential that sends X-Vapi-Secret = WEBHOOK_SECRET (recommended).
VAPI_CREDENTIAL_ID=
# Public URL of your deployment, where Vapi posts tool calls and end-of-call reports (/api/vapi):
WEBHOOK_BASE_URL=https://your-deployment.example.com
# Shared secret checked on every webhook call (header X-Vapi-Secret):
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Calendar (Cal.com) ---
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
# Only if Cal.com moves its API versions again:
# CALCOM_SLOTS_API_VERSION=2024-09-04
# CALCOM_BOOKINGS_API_VERSION=2026-02-25

# --- Email recap (Resend) ---
RESEND_API_KEY=
MAIL_FROM="Accueil <accueil@your-domain.fr>"

# --- SMS (Brevo): recap to the owner, confirmation to the caller ---
BREVO_API_KEY=
# The business's short name, 3 to 11 letters or digits. Carriers filter generic names such as Info or Accueil.
SMS_SENDER=Dupont
CONFIRM_CALLER_SMS=true

# --- Storage for the Node/Vercel entry (the Worker uses D1) ---
# A JSON file is fine for a demo; use Postgres/SQLite/Upstash in production.
DATA_FILE=./data/records.json

# --- Fallback single-client config, used only if config/client.json is absent ---
CLIENT_COMPANY=Plomberie Dupont
CLIENT_METIER=plomberie
CLIENT_HORAIRES=du lundi au vendredi, de 8 h a 18 h
CLIENT_TELEPHONE=05 56 12 34 56
TIME_ZONE=Europe/Paris
# Required: the email recap is the record of every call.
NOTIFY_EMAIL=contact@plomberie-dupont.fr
# Optional: mobiles (06, 07) for the SMS recap, comma-separated, in any usual spelling.
NOTIFY_SMS=06 12 34 56 78
